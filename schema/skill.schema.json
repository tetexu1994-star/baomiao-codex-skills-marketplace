{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baomiao:codex-skills:skill-schema:v1",
  "title": "暴喵 Codex Skill 条目",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "summary_zh", "category", "tags", "publisher", "source", "license", "risk", "review", "install"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary_zh": {"type": "string", "minLength": 12, "maxLength": 180},
    "category": {"enum": ["文档处理", "研发工具", "效率规划", "安全治理", "数据分析", "多媒体"]},
    "tags": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 20}},
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {"enum": ["official", "community"]},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "path", "skill_url", "license_url"],
      "properties": {
        "repository": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "pattern": "^skills/[A-Za-z0-9_./-]+$"},
        "skill_url": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/"},
        "license_url": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["spdx", "scope", "verified_at"],
      "properties": {
        "spdx": {"type": "string", "pattern": "^[A-Za-z0-9.+-]+$"},
        "scope": {"enum": ["skill-directory", "repository"]},
        "verified_at": {"type": "string", "format": "date"}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "capabilities", "has_executable_files", "notes_zh"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "blocked"]},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["filesystem-read", "filesystem-write", "network", "shell", "browser", "credentials", "external-write", "none"]}},
        "has_executable_files": {"type": "boolean"},
        "notes_zh": {"type": "string", "minLength": 4, "maxLength": 240}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "evidence"],
      "properties": {
        "status": {"enum": ["candidate", "needs_changes", "approved", "rejected"]},
        "reviewer": {"type": "string", "minLength": 2, "maxLength": 80},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "evidence": {"type": "string", "pattern": "^docs/reviews/", "maxLength": 200}
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "destination", "requires_auth", "preflight"],
      "properties": {
        "mode": {"const": "copy-source-directory"},
        "destination": {"type": "string", "pattern": "^%USERPROFILE%/\\.codex/skills/[a-z0-9-]+$"},
        "requires_auth": {"type": "boolean"},
        "preflight": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["verify-catalog-digest", "verify-source-commit", "verify-license", "scan-files", "show-source-and-risk", "confirm-user", "backup-existing"]}}
      }
    }
  }
}
